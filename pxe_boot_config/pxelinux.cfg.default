# PXE boot menu configuration
# Copy to /srv/tftp/pxelinux.cfg/default

DEFAULT freebsd

LABEL freebsd
    MENU LABEL Boot FreeBSD Router
    KERNEL mfsbsd-kernel
    APPEND initrd=mfsbsd-initrd.img

PROMPT 1
TIMEOUT 50

# Note: You will need to place FreeBSD boot files in /srv/tftp/
# For FreeBSD PXE boot, you typically need:
# - FreeBSD kernel
# - mfsroot (memory filesystem root)
# Or use mfsBSD which provides a complete bootable system
