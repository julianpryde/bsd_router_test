# Network configuration for Debian PXE boot server
# Copy to /etc/network/interfaces

# Loopback interface
auto lo
iface lo inet loopback

# Primary network interface connected to router's em2 (mgmt)
auto eth0
iface eth0 inet static
    address 192.168.100.1
    netmask 255.255.255.0
    # No gateway needed - this is an isolated boot network
